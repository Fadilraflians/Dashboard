# ============================================
# Shared UI remote (template-shared) - contoh .env (salin ke .env)
# Pure UI building blocks (StatCard, theme tokens) via Module Federation.
# ============================================

# Catatan: PUBLIC_PATH tidak dipakai (output.publicPath = "auto"). SHARED_SCOPE
# ("sharedUi") di-hardcode di webpack. Keduanya tidak dibaca dari env lagi.

# ============================================
# DEVELOPMENT ONLY
# ============================================

SHARED_PORT=9000
