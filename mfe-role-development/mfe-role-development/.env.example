# ============================================
# MFE: Role Management (template-mfe-b) - contoh .env (salin ke .env)
# Satu file .env dipakai untuk dev & prod. Yang membedakan hanya command
# (webpack --mode / NODE_ENV), bukan file-nya.
#
#   dev  : pnpm dev      (webpack serve + BFF, mode development)
#   prod : pnpm build    (bundle statis ke dist/) lalu `pnpm start:api`
#          — BFF yang menyajikan dist/ (remoteEntry.js + chunks) + CORS.
# ============================================

# ============================================
# PRODUCTION (wajib diisi)
# ============================================

# Catatan: APP_KEY ("roleMgmt") & SHARED_SCOPE ("sharedUi") di-hardcode di
# kode (statis), tidak dibaca dari env.

# BFF (src/api/index.mjs)
API_PORT=3102
# BFF forward ke sini + origin yang diizinkan CORS (memuat remoteEntry.js).
# Prod: http://shell.co.id
SHELL_GATEWAY_URL=http://localhost:3000
AUTH_COOKIE_NAME=shell_session

# Shared UI remote — URL remoteEntry.js shared. RUNTIME (BFF /api/runtime-config).
SHARED_URL=http://localhost:9000/remoteEntry.js

# Redis READ-ONLY (hanya baca token)
REDIS_HOST=192.168.188.231
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_KEY_PREFIX=test-micro-fe:

# ============================================
# DEVELOPMENT ONLY (tidak dipakai di prod)
# ============================================

MFE_PORT=3002
API_TARGET=http://localhost:3102
