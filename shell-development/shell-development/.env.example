# ============================================
# Template Shell - contoh .env (salin ke .env, isi nilainya)
# Satu file .env dipakai untuk dev & prod. Yang membedakan hanya command
# (NODE_ENV), bukan file-nya.
#
#   dev  : pnpm dev     (NODE_ENV=development, hot reload)
#   prod : pnpm build && pnpm start   (NODE_ENV=production)
# ============================================

# ============================================
# PRODUCTION (wajib diisi)
# ============================================

SERVER_PORT=3000
AUTH_COOKIE_NAME=shell_session
SESSION_TTL=900
# Secure cookie flag: false untuk HTTP, true untuk HTTPS.
COOKIE_SECURE=false

# Base URL backend API gateway (login/verify-otp)
API_BASE_URL=http://portal-ksei-dev-api-gateway.apps.dev-digi.ocp.hq.bni.co.id

REDIS_HOST=192.168.188.231
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_KEY_PREFIX=test-micro-fe:

# Default backend (dipakai bila MFE_<APP>_BACKEND_URL tidak ada). Kosong -> 501 -> mock.
BACKEND_URL=

# ─── MFE: DashboardBOK (app key: dashboardBok) ───
# Satu blok per MFE dengan prefix MFE_<APP>_. Backend_Url = base URL backend
# MFE ini (Opsi X). Gateway memilih backend via APP_KEY -> MFE_<APP>_BACKEND_URL.
# Scope HARUS sama dengan APP_KEY di MFE (webpack name = APP_KEY).
MFE_DASHBOARDBOK_SCOPE=dashboardBok
MFE_DASHBOARDBOK_MODULE=./mount
MFE_DASHBOARDBOK_URL=http://localhost:3001/remoteEntry.js
MFE_DASHBOARDBOK_BACKEND_URL=http://portal-ksei-dev-api-gateway.apps.dev-digi.ocp.hq.bni.co.id
MFE_DASHBOARDBOK_BFF_URL=http://localhost:3101

# ─── MFE: Role Management (app key: roleMgmt) ───
# MFE kedua. Scope HARUS sama dengan APP_KEY di rnd-template-mfe-b.
MFE_ROLEMGMT_SCOPE=roleMgmt
MFE_ROLEMGMT_MODULE=./mount
MFE_ROLEMGMT_URL=http://localhost:3002/remoteEntry.js
MFE_ROLEMGMT_BACKEND_URL=http://portal-ksei-dev-api-gateway.apps.dev-digi.ocp.hq.bni.co.id
MFE_ROLEMGMT_BFF_URL=http://localhost:3102

# Shared UI remote (sharedUi). Diteruskan ke MFE via /api/config -> mount(props)
# agar MFE me-resolve shared remote saat RUNTIME (bukan build-time).
SHARED_URL=http://localhost:9000/remoteEntry.js

# Public shared URL for DashboardWidgetGrid (client-side remote loading)
NEXT_PUBLIC_SHARED_URL=http://localhost:9000

# AI backend (mock-backend Text-to-SQL endpoint)
AI_BACKEND_URL=http://127.0.0.1:3200/api/ai/query

# Catatan: nama app di UI ("Portal MFE") di-hardcode di kode (bukan env),
# karena NEXT_PUBLIC_* build-time dan nama app statis.

# ============================================
# DEVELOPMENT ONLY (tidak dipakai di prod)
# ============================================

LOG_LEVEL=info
